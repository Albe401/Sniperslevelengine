{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci && npm --prefix frontend ci",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "excludeFiles": "{engine/**,desktop-writer/**,verification/**,**/*.test.*}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__snipersRoute=:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/((?!api/).*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "same-origin" },
      { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://sniperstradingacademy.com https://www.sniperstradingacademy.com http://localhost:3000" }
    ] }
  ]
}
